model StudentAcademicLevel {
  id          String  @id @default(cuid())
  studentId   String
  orderIndex  Int
  level       String
  institution String
  board       String?
  group       String?
  major       String?
  grade       String?
  passingYear String?
}

// One shared record per student — edited from any of their applications' Financial Readiness
// stage, and broadcast back out to every one of their applications (see server's
// applications/:id/journey/financial_readiness route and the frontend's applicationJourneyStore.ts
// updateStage), instead of each application tracking its own independent copy. `completedAt`
// mirrors the same "Ready"/"Matured" terminal-status rule the per-application StageRecord uses, so
// a counsellor's outstanding "fill this in" task (see taskBoard.ts) disappears the moment it's set.
model StudentFinancialReadiness {
  studentId         String    @id
  student           Student   @relation(fields: [studentId], references: [id])
  evidenceRequired  Boolean   @default(true)
  requiredAmount    Float?
  currency          String?
  holdingPeriodDays Int?
  openingDate       DateTime? @db.Date
  maturityDate      DateTime? @db.Date
  bankStatus        String    @default("Not Started")
  bankName          String?
  accountHolder     String?
  accountType       String?
  depositType       String?
  completedAt       DateTime?
  updatedAt         DateTime  @updatedAt
  history           StudentFinancialReadinessHistory[]
}

// Append-only audit trail of every save to a student's Financial Readiness record — one row per
// save that actually changed something, with who made it and the field-level before/after list.
// Written by server/src/financialReadinessRecord.js regardless of which door the edit came in
// through (student Dashboard form or a counsellor's Journey panel).
model StudentFinancialReadinessHistory {
  id            String                    @id @default(cuid())
  studentId     String
  record        StudentFinancialReadiness @relation(fields: [studentId], references: [studentId], onDelete: Cascade)
  changedAt     DateTime                  @default(now())
  changedById   String
  changedByRole String
  changedByName String
  changes       Json

  @@index([studentId, changedAt])
}

model Shortlist {
  id             String   @id @default(cuid())
  studentId      String
  universityId   String
  universityName String
  courseName     String
  addedByRole    Role
  addedAt        DateTime @default(now())

  @@unique([studentId, universityId, courseName])
}

model ApplicationNextStep {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])
  title         String
  createdAt     DateTime    @default(now())
  done          Boolean     @default(false)
  // Set the moment `done` flips true — once set, the step is locked (the UI no longer lets it be
  // un-checked), so this date is a permanent record of when it was actually completed.
  completedAt   DateTime?
  dueDate       DateTime?   @db.Date
}

// ============================================================
// Interview Prep — credibility-interview practice (see the build plan this implements).
// `userId` on InterviewSession is a plain reference to User.id, not a Prisma relation — same
// pattern as ApplicationActivity.performedById elsewhere in this file, so adding this feature
// never requires touching the User model itself.
// ============================================================

enum InterviewSessionStatus {
  in_progress
  completed
}

model InterviewQuestionSet {
  id            String   @id @default(cuid())
  name          String
  institutionId String?
  createdAt     DateTime @default(now())

  questions InterviewQuestion[]
  sessions  InterviewSession[]
}

model InterviewQuestion {
  id            String               @id @default(cuid())
  questionSetId String
  questionSet   InterviewQuestionSet @relation(fields: [questionSetId], references: [id])
  prompt        String
  category      String
  // Display/answering order within the set — ties matter, so an explicit index instead of relying
  // on createdAt.
  orderIndex    Int                  @default(0)

  answers InterviewAnswer[]

  @@index([questionSetId, orderIndex])
}

model InterviewSession {
  id            String               @id @default(cuid())
  userId        String
  questionSetId String
  questionSet   InterviewQuestionSet @relation(fields: [questionSetId], references: [id])
  status        InterviewSessionStatus @default(in_progress)
  // Average of every answer's own `overall` so far — recomputed on each answer, final once status
  // flips to completed.
  overallScore  Float?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  answers InterviewAnswer[]

  @@index([userId, createdAt])
}

model InterviewAnswer {
  id         String            @id @default(cuid())
  sessionId  String
  session    InterviewSession  @relation(fields: [sessionId], references: [id])
  questionId String
  question   InterviewQuestion @relation(fields: [questionId], references: [id])
  answerText String
  // { relevance, consistency, specificity, genuineness } — each 0-100, per the rubric.
  scores     Json
  // { feedback: string[], flags: string[] } — kept as one Json blob rather than two columns since
  // both are always read/written together and neither is queried by its internal shape.
  feedback   Json
  overall    Float
  createdAt  DateTime          @default(now())

  @@index([sessionId])
  @@unique([sessionId, questionId])
}

// Same queue as CourseImportItem, for whole universities: one pasted university web page per row,
// drafted by the model (universityExtraction.js), created only when staff approve it from the
// university form. `countryHint` is the country the staff member chose for the batch — pages
// rarely state it and it must match the catalog's country list exactly.
model UniversityImportItem {
  id                   String             @id @default(cuid())
  sourceUrl            String
  // Further pages of the same university read together with sourceUrl (fees, entry
  // requirements, scholarships…) — a single page rarely states everything.
  extraUrls            String[]           @default([])
  status               CourseImportStatus @default(queued)
  countryHint          String?
  textSource           String?
  pageText             String?
  extracted            Json?
  error                String?
  createdBy            String
  approvedUniversityId String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([createdAt])
}
