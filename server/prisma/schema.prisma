// StudyOne — Postgres schema (Prisma). See /Users/mdabdullaalkamran/.claude/plans/my-ami-is-this-shimmering-hamster.md
// for the migration plan this implements. Phase 1 models (User, Student, Staff, Application,
// ApplicationJourney, ApplicationStatusHistory, ApplicationActivity, Task, Message) have full
// routes + frontend wiring. Everything else here is schema designed ahead of time for a later
// phase — table shape is settled now so later migrations don't require schema surgery, but no
// routes exist for them yet.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ---------- Enums ----------

enum Role {
  student
  agent
  counsellor
  admission
  compliance
  data
  finance
  admin
}

enum RiskFlag {
  none
  watch
  high
}

enum StaffStatus {
  Active
  Invited
  Inactive
}

enum AppStatus {
  Draft
  ProfileIncomplete            @map("Profile Incomplete")
  DocumentsPending             @map("Documents Pending")
  ReadyForReview               @map("Ready for Review")
  EligibilityReview            @map("Eligibility Review")
  ApplicationPreparing         @map("Application Preparing")
  ReadyToSubmit                @map("Ready to Submit")
  Submitted
  UniversityReview             @map("University Review")
  AdditionalDocumentsRequested @map("Additional Documents Requested")
  OfferReceived                @map("Offer Received")
  OfferConditionsPending       @map("Offer Conditions Pending")
  DepositPending               @map("Deposit Pending")
  DepositPaid                  @map("Deposit Paid")
  CasCoePending                @map("CAS/COE Pending")
  CasCoeIssued                 @map("CAS/COE Issued")
  VisaPreparation              @map("Visa Preparation")
  VisaSubmitted                @map("Visa Submitted")
  VisaDecision                 @map("Visa Decision")
  Enrolled
  Deferred
  Withdrawn
  Rejected
  ComplianceHold               @map("Compliance Hold")
}

enum WaitingOn {
  student
  staff
  university
  none
}

enum ApplicationSource {
  student
  counsellor
}

enum StageType {
  application
  offer
  financial_readiness
  payment
  interview
  university_document
  visa
  evisa
  enrolment
}

enum Priority {
  low
  medium
  high
}

// ============================================================
// PHASE 1 — full routes + frontend wiring
// ============================================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  // -> Student.id (role=student) or Staff.id (every other role). Polymorphic app-level reference,
  // not a DB FK (Prisma can't target two tables from one FK column) — enforced by the seed script
  // and any future staff-invite flow.
  roleUserId   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Student {
  id           String    @id
  name         String
  email        String    @unique
  phone        String?
  country      String
  agentId      String?
  agent        Staff?    @relation("AgentStudents", fields: [agentId], references: [id])
  counsellorId String?
  counsellor   Staff?    @relation("CounsellorStudents", fields: [counsellorId], references: [id])
  avatarColor  String
  riskFlag     RiskFlag?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  applications        Application[]
  tasks               Task[]
  documents           Document[]
  financialReadiness  StudentFinancialReadiness?
  comments            StudentComment[]
}

model Staff {
  id           String      @id
  name         String
  email        String      @unique
  role         Role
  status       StaffStatus @default(Active)
  organization String?
  phone        String?
  avatarColor  String
  // Short public code (agents only, lazily generated on first self-fetch — see GET /staff/me)
  // shared as a link/QR so a prospective student's signup auto-connects to this agent.
  referralCode String?     @unique
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  studentsAsAgent                Student[]      @relation("AgentStudents")
  studentsAsCounsellor           Student[]      @relation("CounsellorStudents")
  applicationsAsCounsellor       Application[]  @relation("CounsellorApplications")
  applicationsAsAdmissionOfficer Application[]  @relation("AdmissionOfficerApplications")
  commissions                    CommissionTx[]
  invoices                       AgentInvoice[]

  @@index([role])
}

model Application {
  id                            String             @id
  studentId                     String
  student                       Student            @relation(fields: [studentId], references: [id])
  university                    String
  course                        String
  intake                        String
  country                       String
  campus                        String?
  status                        AppStatus
  progress                      Int
  nextAction                    String
  waitingOn                     WaitingOn
  stages                        Json // legacy WorkflowStage[] display strip, superseded by journey but kept for UI compat
  source                        ApplicationSource?
  responsibleCounsellorId       String?
  responsibleCounsellor         Staff?             @relation("CounsellorApplications", fields: [responsibleCounsellorId], references: [id])
  responsibleAdmissionOfficerId String?
  responsibleAdmissionOfficer   Staff?             @relation("AdmissionOfficerApplications", fields: [responsibleAdmissionOfficerId], references: [id])
  createdAt                     DateTime           @default(now())
  updatedAt                     DateTime           @updatedAt

  journey             ApplicationJourney?
  statusHistory       ApplicationStatusHistory[]
  activity            ApplicationActivity[]
  tasks               Task[]
  documents           Document[]
  documentDueDates    DocumentDueDate[]
  invoiceLines        InvoiceLine[]
  ApplicationNextStep ApplicationNextStep[]

  @@index([studentId])
  @@index([status])
}

model ApplicationJourney {
  id            String      @id @default(cuid())
  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id])
  stages        Json // ApplicationJourney["stages"] from src/types/journey.ts, whole-blob read/write
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model ApplicationStatusHistory {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])
  status        AppStatus
  changedAt     DateTime    @default(now())

  @@index([applicationId, changedAt])
}

model ApplicationActivity {
  id              String      @id @default(cuid())
  applicationId   String
  application     Application @relation(fields: [applicationId], references: [id])
  timestamp       DateTime    @default(now())
  stageType       StageType?
  action          String
  oldValue        Json?
  newValue        Json?
  // Freeform commentary (e.g. a counsellor's add_application_note AI tool call) — kept distinct
  // from oldValue/newValue, which represent what actually changed, not arbitrary remarks about it.
  notes           String?
  performedById   String
  performedByRole Role
  performedByName String

  @@index([applicationId, timestamp])
}

model Task {
  id             String       @id @default(cuid())
  title          String
  description    String?
  assignedToId   String
  assignedToRole Role
  assignedToName String
  assignedById   String
  assignedByRole Role
  assignedByName String
  dueDate        DateTime?    @db.Date
  done           Boolean      @default(false)
  createdAt      DateTime     @default(now())
  studentId      String?
  student        Student?     @relation(fields: [studentId], references: [id])
  studentName    String?
  applicationId  String?
  application    Application? @relation(fields: [applicationId], references: [id])
  stageType      StageType?
  taskType       String?
  priority       Priority?
  externalOwner  String?

  @@index([assignedToId, assignedToRole])
  @@index([applicationId])
}

model Message {
  id        String   @id @default(cuid())
  threadId  String
  fromId    String
  fromRole  Role
  fromName  String
  toId      String
  toRole    Role
  toName    String
  text      String
  // Read by the "to" party. Whoever sent it obviously doesn't need this to track their own message.
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([threadId, createdAt])
  @@index([toId, toRole, read])
}

// ============================================================
// DEFERRED — schema designed now, routes/frontend migration later (see plan file §"Deferred")
// ============================================================

enum DocumentStatus {
  pending
  requested
  uploaded
  under_review
  verified
  rejected
  flagged
  expired
}

enum DocumentScope {
  core
  application
  stage
}

model Document {
  id              String         @id @default(cuid())
  studentId       String
  student         Student        @relation(fields: [studentId], references: [id])
  applicationId   String?
  application     Application?   @relation(fields: [applicationId], references: [id])
  stageType       StageType?
  scope           DocumentScope
  name            String
  type            String
  status          DocumentStatus @default(pending)
  fileUrl         String?
  custom          Boolean        @default(false)
  note            String?
  rejectionReason String?
  issuedDate      DateTime?      @db.Date
  expiryDate      DateTime?      @db.Date
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([applicationId, stageType])
  @@index([studentId])
}

model DocumentDueDate {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id])
  docType       String
  dueDate       DateTime    @db.Date

  @@unique([applicationId, docType])
}

enum CommissionStatus {
  NotEligible
  Expected
  Pending
  Approved
  Invoiced
  Paid
  Disputed
  ClawedBack
}

enum InvoiceStatus {
  Issued
  Paid
}

model CommissionTx {
  id         String           @id @default(cuid())
  agentId    String
  agent      Staff            @relation(fields: [agentId], references: [id])
  studentId  String
  university String
  amount     Float
  currency   String
  status     CommissionStatus
  milestone  String
  updatedAt  DateTime         @updatedAt
}

// Per-university commission agreement, set by admin (see routes/commissionRates.js). Either a
// percentage of the course tuition fee or a fixed USD amount per enrolment — the platform bonus is
// always a percentage of tuition layered on top. A university with no row simply has no rate yet.
model CommissionRate {
  id             String   @id @default(cuid())
  universityId   String   @unique
  mode           String   @default("percent") // "percent" | "fixed"
  ratePercent    Float    @default(0)
  fixedAmountUSD Float    @default(0)
  bonusPercent   Float    @default(0)
  bonusLabel     String   @default("")
  updatedAt      DateTime @default(now()) @updatedAt
}

model AgentInvoice {
  id          String        @id
  agentId     String
  agent       Staff         @relation(fields: [agentId], references: [id])
  createdAt   DateTime      @default(now())
  totalAmount Float
  status      InvoiceStatus @default(Issued)
  lines       InvoiceLine[]
}

model InvoiceLine {
  id            String       @id @default(cuid())
  invoiceId     String
  invoice       AgentInvoice @relation(fields: [invoiceId], references: [id])
  applicationId String
  application   Application  @relation(fields: [applicationId], references: [id])
  studentName   String
  university    String
  course        String
  amount        Float
}

enum SubjectType {
  Student
  Agent
  Document
  Application
}

enum RiskLevel {
  low
  medium
  high
}

enum ComplianceStatus {
  Open
  Investigating
  Frozen
  Cleared
  Escalated
}

model ComplianceCase {
  id          String           @id @default(cuid())
  subjectType SubjectType
  subjectName String
  reason      String
  riskLevel   RiskLevel
  status      ComplianceStatus
  openedAt    DateTime         @default(now())
  evidence    String[]
}

enum CatalogRecordType {
  University
  Course
  Intake
  Requirement
  Scholarship
}

enum CatalogRecordStatus {
  Draft
  InReview
  Published
  Stale
}

model CatalogRecord {
  id               String              @id @default(cuid())
  type             CatalogRecordType
  name             String
  country          String
  source           String
  effectiveDate    DateTime            @db.Date
  verificationDate DateTime            @db.Date
  status           CatalogRecordStatus
  owner            String
}

enum WorkflowTemplateStatus {
  Active
  Draft
  Archived
}

model WorkflowTemplate {
  id          String                 @id @default(cuid())
  name        String
  country     String
  version     String
  stages      Int
  status      WorkflowTemplateStatus
  lastUpdated DateTime               @updatedAt
}

model AuditLogEntry {
  id        String   @id @default(cuid())
  actor     String
  role      Role
  action    String
  target    String
  timestamp DateTime @default(now())
}

enum RequirementType {
  document
  financial_holding_period
  immigration_document_type
}

model RequirementRule {
  id              String          @id
  countryId       String?
  universityId    String?
  courseId        String?
  stageType       StageType
  requirementType RequirementType
  name            String
  isRequired      Boolean
  configuration   Json?
  active          Boolean         @default(true)
}

model Country {
  id   String @id
  name String @unique
}

// A field-of-study Data Management can author real content for — a "why this subject" blurb shown
// to students browsing it, its curriculum modules, and its recognized accrediting bodies. `modules`
// feeds subjectCurriculum.ts's curriculumFor(), taking priority over that file's static defaults
// once a subject has real data entered here, so this form isn't a dead end nobody reads from.
model Subject {
  id             String   @id @default(cuid())
  name           String   @unique
  custom         Boolean  @default(false)
  description    String?
  modules        String[]
  // Typical career outcomes for the field — the subject-level default for a course's Careers tab,
  // the same way `modules` is for its Modules tab (see subjectCurriculum.ts's curriculumFor).
  careers        String[] @default([])
  accreditations String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum DepositMode {
  custom
  half
  full
}

enum UniversityTone {
  violet
  amber
  teal
  rose
}

// Mirrors src/types/index.ts's University interface field-for-field — nested/nullable shapes
// (requirements/englishRequirements split by degree level, scholarships, campuses, the
// intakeStatus/intakeDates maps keyed by month) are stored as Json rather than normalized into
// their own tables, same trade-off as Application.stages, since nothing here is queried by its
// internal shape, only read/written whole.
model University {
  id                         String         @id
  name                       String
  city                       String
  country                    String
  tags                       String[]
  subjects                   String[]
  intakes                    String[]
  worldRank                  String
  qsRanking                  String?
  timesHigherRanking         String?
  employability              String
  studentCount               String
  description                String
  highlights                 String[]
  campuses                   Json?
  requirements               Json // { undergraduate: string[]; postgraduate: string[] }
  fees                       Json
  minimumDepositAmount       Float?
  depositMode                DepositMode?
  paymentDeadline            String?
  depositRules               String[]
  admissionSteps             String[]
  restrictedRegions          String[]
  currencySymbol             String
  minIELTS                   Float
  minGPA                     Float
  englishRequirements        Json?
  moiAccepted                Boolean?
  moiAcceptedUniversities    String[]
  internalEnglishTestOffered Boolean?
  internalEnglishTestFree    Boolean?
  internalEnglishTestFee     Float?
  accreditations             String[]
  scholarshipsAvailable      Boolean
  scholarships               Json?
  openIntake                 String
  intakeStatus               Json?
  intakeDates                Json?
  website                    String
  tone                       UniversityTone
  logoUrl                    String?
  coverPhotoUrl              String?
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt
  courses                    Course[]
  courseImports              CourseImportItem[]
}

model Course {
  id                  String     @id
  universityId        String
  university          University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  name                String
  level               String
  duration            String
  subject             String
  feeUSD              Float
  intakes             String[]
  applicationDeadline String?
  requirements        String[]
  englishRequirements Json?
  currencySymbol      String?
  // Which of the university's campuses this course runs at (ids from University.campuses) —
  // empty means every campus. Replaced the single `campusId`; the migration carried old values over.
  campusIds           String[]   @default([])
  // Course-page content Data Management enters directly on the course. `modules`/`careers` empty
  // means "use the subject's lists" (see subjectCurriculum.ts); `description`/`studyMode` unset
  // fall back to a generated blurb and "Full-time".
  description         String?
  studyMode           String?
  modules             String[]   @default([])
  careers             String[]   @default([])
  // Bodies that accredit this specific course — [{ name, logoUrl? }], the logo a data URL like the
  // university's own `logoUrl`. Distinct from University.accreditations (institution-level).
  accreditations      Json?

  @@index([universityId])
}

enum CourseImportStatus {
  queued
  running
  needs_review
  approved
  discarded
  failed
}

// One pasted course-page URL in Data Management's AI import queue (see routes/courseImports.js).
// Nothing here touches Course until a staff member approves the row from the course form — the
// model only drafts. `pageText` is the cleaned text the model saw (capped), kept so a re-run after
// a failed extraction doesn't refetch; `extracted` is the ExtractionResult (draft course +
// per-field confidence, evidence quotes and warnings) built by courseExtraction.js.
model CourseImportItem {
  id               String             @id @default(cuid())
  universityId     String
  university       University         @relation(fields: [universityId], references: [id], onDelete: Cascade)
  sourceUrl        String
  status           CourseImportStatus @default(queued)
  textSource       String?
  pageText         String?
  extracted        Json?
  error            String?
  createdBy        String
  approvedCourseId String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([universityId, createdAt])
}

// A real, persisted in-app inbox row — one per (recipient, event). Distinct from the WhatsApp/email
// dispatcher in notifications/dispatch.js (an outbound message to a phone/email address, nothing
// kept server-side); this is what the bell icon in every role's header actually reads. First
// producer is an application comment (see ApplicationActivity action "comment_added" and
// applications.js's getApplicationParticipants), but `type`/`applicationId`/`activityId` are generic
// enough for future notification kinds to reuse the same table.
model Notification {
  id            String   @id @default(cuid())
  userId        String
  userRole      Role
  type          String
  title         String
  body          String?
  studentId     String?
  applicationId String?
  activityId    String?
  read          Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([userId, userRole, createdAt])
}

model LeadFollowUp {
  studentId String   @id
  status    String
  updatedAt DateTime @updatedAt
}

model ProfileStepCompletion {
  id          String    @id @default(cuid())
  studentId   String
  stepKey     String
  complete    Boolean   @default(false)
  completedAt DateTime?

  @@unique([studentId, stepKey])
}

model TeamLead {
  role    Role   @id
  staffId String @unique
}

// A shared comment thread on a student's overall case — not tied to one specific application (see
// ApplicationActivity's own "comment_added" rows for that). Replaces the old single-row, always-
// overwritten StaffNote — every comment here is its own row, from any of the student, their
// counsellor or their agent, and posting one notifies the others' in-app inbox (see the
// Notification model and server/src/routes/students.js).
model StudentComment {
  id              String   @id @default(cuid())
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id])
  notes           String
  performedById   String
  performedByRole Role
  performedByName String
  createdAt       DateTime @default(now())

  @@index([studentId, createdAt])
}

model StaffStatsSnapshot {
  namespace String   @id
  date      DateTime @db.Date
  values    Json
}

model CounsellorSettings {
  staffId            String  @id
  emailNotifications Boolean @default(true)
  taskReminders      Boolean @default(true)
  weeklyDigest       Boolean @default(false)
}

model CounsellorSeenApplication {
  staffId       String
  applicationId String
  seenAt        DateTime @default(now())

  @@id([staffId, applicationId])
}

enum MeetingAction {
  Join
  Email
  Prepare
  View
}

enum MeetingKind {
  session
  task
}

model Meeting {
  id        String        @id @default(cuid())
  staffId   String
  time      String
  title     String
  subtitle  String
  studentId String?
  action    MeetingAction
  kind      MeetingKind
