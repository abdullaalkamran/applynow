# Copy to .env for local development. In production (cPanel "Setup Node.js App"),
# set these through the app's Environment Variables UI instead of a file.

# Which provider handles /api/assistant: anthropic | openai | gemini | ollama | stub
# All of the settings below can also be changed live, without a restart, through the Admin AI
# Settings page in the app (/admin/ai-settings) once ADMIN_SETTINGS_TOKEN is set — these env vars
# are just the deploy-time defaults.
AI_PROVIDER=stub

# Which voice engine the floating assistant/voice pages use: browser | openai | gemini-live
VOICE_ENGINE=browser

# Required to unlock the Admin AI Settings page (GET/PUT /api/admin/settings). Leave blank to
# disable that page entirely (it fails closed, not open, when unset). Pick a long random value.
ADMIN_SETTINGS_TOKEN=

# Signs login session tokens. If unset, a random one is generated per process start (fine for
# local dev — every restart logs everyone out) — always set a real value before deploying.
JWT_SECRET=

# "Sign in / up with Google" (POST /api/auth/google). From Google Cloud Console: APIs & Services ->
# Credentials -> Create Credentials -> OAuth client ID -> Web application. Add your frontend's
# origin(s) (e.g. http://localhost:5173) under "Authorized JavaScript origins" — no redirect URI
# needed, this uses Google Identity Services' token flow, not a server-side redirect. The same
# value must also be set as VITE_GOOGLE_CLIENT_ID in the frontend's .env. Leave blank to disable
# the feature — the route responds 503 and the frontend hides the button.
GOOGLE_CLIENT_ID=

# Local MySQL connection string for Prisma (Spaceship's shared hosting only exposes MySQL, not
# PostgreSQL, in cPanel — see cPanel's "MySQL Databases" tool for production credentials).
# Set this in your deployment environment as well.
DATABASE_URL=mysql://root:root@localhost:3306/unifinderai

# Only the origin(s) allowed to call this API — your deployed frontend's URL.
# Comma-separate multiple origins, e.g. for local dev + production.
FRONTEND_ORIGIN=http://localhost:5173

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- OpenAI --- (also used for real voice: Whisper transcription + TTS speech, independent of
# whether OpenAI is the AI_PROVIDER used for reasoning/tool-calling)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

# --- Gemini --- (GEMINI_LIVE_MODEL is used for the realtime Gemini Live voice relay)
# Google renames/retires these periodically — if either 404s, call GET
# https://generativelanguage.googleapis.com/v1beta/models?key=YOUR_KEY (or /v1alpha/models for
# live-capable ones, filtering supportedGenerationMethods for "bidiGenerateContent") to see what's
# currently available for your key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-latest

# --- Ollama (local model, dev/testing only) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- WhatsApp + email status-change notifications ---
# All of the settings below can also be changed live, without a restart, through the Admin
# Notifications page in the app (/admin/notifications) once ADMIN_SETTINGS_TOKEN is set — these
# env vars are just the deploy-time defaults. Which statuses actually send a message, and the
# message text itself, is configured separately on that same page (not via env vars).

# Which provider sends WhatsApp messages: meta | twilio | stub
WHATSAPP_PROVIDER=stub
WHATSAPP_META_TOKEN=
WHATSAPP_META_PHONE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# Which provider sends email: sendgrid | brevo | stub
EMAIL_PROVIDER=stub
SENDGRID_API_KEY=
# Brevo's transactional email API key (Brevo → Settings → SMTP & API → API Keys) — only read when
# EMAIL_PROVIDER=brevo. Falls back to whatever the email API key is set to above (env var or an
# Admin → Settings override) if unset, so you don't need a second key if you only use one provider.
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=UnifinderAi

# PORT is injected by cPanel/Passenger in production — only used as a local-dev fallback.
PORT=8787
