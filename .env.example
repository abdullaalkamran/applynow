# Copy to .env for local development (Vite only exposes vars prefixed VITE_ to client code).

# Where the backend API lives — defaults to http://localhost:8787 if unset.
VITE_ASSISTANT_API_BASE=http://localhost:8787

# "Sign in / up with Google". Must be the exact same OAuth Client ID as the server's
# GOOGLE_CLIENT_ID (see server/.env.example for how to create one in Google Cloud Console).
# Leave blank to keep the feature hidden — Login/Signup fall back to a plain "not configured"
# placeholder instead of a non-functional button.
VITE_GOOGLE_CLIENT_ID=
